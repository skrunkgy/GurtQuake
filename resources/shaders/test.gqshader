#shader VERTEX

layout (location = 0) in vec3 POSITION;
// layout (location = 1) in vec2 UV;
// layout (location = 2) in vec3 NORMAL;

uniform mat4 MODEL_MAT;
uniform mat4 VIEW_MAT;
uniform mat4 PROJ_MAT;

out vec2 outPos;

void main()
{
    gl_Position = PROJ_MAT * VIEW_MAT * MODEL_MAT * vec4(POSITION, 1.0);
    outPos = POSITION.xy;
}

#shader FRAGMENT

in vec2 outPos;
out vec4 fragOut;

void main()
{
	float equation = outPos.y - (.5 * pow(outPos.x, 2) - .7);
	
    if (distance(outPos, vec2(0, 0)) < .2)
    {
        if (distance(vec2(outPos.x, outPos.y * .3), vec2(0, 0)) < .05)
        {
            fragOut = vec4(0, 0, 0, 1);
            return;
        }
        fragOut = vec4(1);
        return;
    }
    fragOut = vec4(0.153, 0.588, 0.337, 1.0) * clamp(equation, 0, 2); // vanessas hand-picked color :))
}
