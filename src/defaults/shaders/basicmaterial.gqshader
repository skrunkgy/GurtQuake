#shader VERTEX

#extension GL_NV_uniform_buffer_std430_layout : enable

layout (location = 0) in vec3 POSITION;
layout (location = 1) in vec2 UV;
layout (location = 2) in vec3 NORMAL;

layout (std140, binding = 0) uniform CameraInfo
{
	mat4 VIEW_MAT;
	mat4 PROJ_MAT;
	vec3 VIEW_POS;
};

uniform mat4 MODEL_MAT;

out INOUT
{
	vec3 pos;
	vec2 uv;
} VS_OUT;

void main()
{
    gl_Position = PROJ_MAT * VIEW_MAT * MODEL_MAT * vec4(POSITION, 1.0);

	VS_OUT.pos = vec3(VIEW_MAT * MODEL_MAT * vec4(POSITION, 1.0));
	VS_OUT.uv = UV;
}

#shader FRAGMENT

struct SunLight
{
	vec3 direction;
	float brightness;
	vec3 color;
};

struct PointLight
{
	vec3 position;
	float brightness;
	vec3 color;
	float exponent;
};

layout (std430, binding = 2) buffer Lights
{
	SunLight sunLight;
	int nLights;
	PointLight lightArr[];
};


in INOUT
{
	vec3 pos;
	vec2 uv;
} FS_IN;

// Parameters
layout(binding = 0) uniform sampler2D DIFFUSE_TEX;
// layout(binding = 1) sampler2D NORMAL_TEX;
// layout(binding = 2) sampler2D ROUGH_TEX;
// layout(binding = 3) sampler2D SPECULAR_TEX;
// layout(binding = 4) sampelr2D EMISSION_TEX

layout(binding = 1) uniform samplerCube CUBEMAP;

uniform struct MATERIAL
{
	float roughness;
	float specular;
	float emission;
} MAT_PARAMS;

out vec4 COLOR;

void main()
{
    COLOR = texture(DIFFUSE_TEX, FS_IN.uv);
}
